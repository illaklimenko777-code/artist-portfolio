---
import logo from "../assets/img/logo.png";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href={logo.src} />
		<title>Олександра Глущенко — Alexandra Hlushchenko | Contemporary Artist</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	@font-face {
		font-family: "Inter";
		src: url("../assets/fonts/Inter-VariableFont_opsz,wght.ttf") format("truetype");
		font-style: normal;
		font-weight: 100 900;
		font-display: swap;
	}

	@font-face {
		font-family: "Inter";
		src: url("../assets/fonts/Inter-Italic-VariableFont_opsz,wght.ttf") format("truetype");
		font-style: italic;
		font-weight: 100 900;
		font-display: swap;
	}

	@font-face {
		font-family: "Lora";
		src: url("../assets/fonts/Lora-VariableFont_wght.ttf") format("truetype");
		font-style: normal;
		font-weight: 400 700;
		font-display: swap;
	}

	@font-face {
		font-family: "Lora";
		src: url("../assets/fonts/Lora-Italic-VariableFont_wght.ttf") format("truetype");
		font-style: italic;
		font-weight: 400 700;
		font-display: swap;
	}

	@view-transition {
		navigation: auto;
	}

	html {
		height: 100%;
	}

	:global(body) {
		margin: 0;
		width: 100%;
		min-height: 100%;
		font-family: "Inter", Arial, sans-serif;
		font-size: 14px;
		font-weight: 400;
		line-height: 1.85;
		letter-spacing: 0.02em;
	}

	:global(h1),
	:global(h2),
	:global(h3),
	:global(.brand-name),
	:global(.project-card h3),
	:global(.artist-contact h3),
	:global(.project-artwork-modal h2),
	:global(.home-artwork-title),
	:global(.biography-artwork-modal h2) {
		font-family: "Lora", Georgia, "Times New Roman", serif;
		font-weight: 400;
	}

	:global(h1),
	:global(.brand-name) {
		font-size: 26px;
	}

	:global(h1),
	:global(.brand-name) {
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	:global(h2) {
		font-size: 26px;
		line-height: 1.3;
	}

	:global(h3),
	:global(.project-card h3),
	:global(.artist-contact h3),
	:global(.project-artwork-modal h2),
	:global(.home-artwork-title),
	:global(.biography-artwork-modal h2) {
		font-size: 17px;
	}

	:global(.biography-lead) {
		font-family: "Lora", Georgia, "Times New Roman", serif;
		font-size: 21px;
		font-weight: 400;
		line-height: 1.6;
		letter-spacing: normal;
	}

	::view-transition-old(root) {
		animation: 180ms ease both page-fade-out;
	}

	::view-transition-new(root) {
		animation: 180ms 40ms ease both page-fade-in;
	}

	@keyframes page-fade-out {
		to {
			opacity: 0;
		}
	}

	@keyframes page-fade-in {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		::view-transition-old(root),
		::view-transition-new(root) {
			animation-duration: 1ms;
			animation-delay: 0ms;
		}
	}
</style>
