---
import type { ImageMetadata } from "astro";

interface Props {
	image: ImageMetadata;
	index: number;
	series: string;
	altUk: string;
	altEn: string;
	titleUk: string;
	titleEn: string;
	descriptionUk: string;
	descriptionEn: string;
}

const { image, index, series, altUk, altEn, titleUk, titleEn, descriptionUk, descriptionEn } = Astro.props;
---

<article class="artwork-card" data-series={series} data-artwork-index={index}>
	<figure class="artwork-image-frame" role="button" tabindex="0" aria-label={altUk}>
		<img
			src={image.src}
			alt={altUk}
			data-alt-uk={altUk}
			data-alt-en={altEn}
			loading="lazy"
			width={image.width}
			height={image.height}
		/>
		<figcaption data-uk="7 ФОТО + ВІДЕО" data-en="7 PHOTOS + VIDEO">7 ФОТО + ВІДЕО</figcaption>
	</figure>

	<p class="artwork-series" data-uk="СЕРІЯ «EXUVIAE»" data-en="“EXUVIAE” SERIES">СЕРІЯ «EXUVIAE»</p>
	<h2>
		<span data-uk={titleUk} data-en={titleEn}>{titleUk}</span>
		<span class="artwork-title-arrow" aria-hidden="true">&rarr;</span>
	</h2>
	<p class="artwork-description" data-uk={descriptionUk} data-en={descriptionEn}>{descriptionUk}</p>
</article>

<style>
	.artwork-card {
		min-width: 0;
		cursor: pointer;
	}

	.artwork-image-frame {
		position: relative;
		aspect-ratio: 0.74;
		margin: 0 0 10px;
		padding: 7px;
		background: #ffffff;
		cursor: pointer;
	}

	.artwork-image-frame:focus-visible {
		outline: 1px solid #111111;
		outline-offset: 2px;
	}

	.artwork-image-frame img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		outline: 1px solid transparent;
		outline-offset: 10px;
		transition: transform 180ms ease, outline-color 180ms ease;
	}

	@media (hover: hover) {
		.artwork-card:hover .artwork-image-frame img {
			outline-color: #111111;
			transform: scale(1.015);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.artwork-image-frame img {
			transition: none;
		}
	}

	.artwork-image-frame figcaption {
		position: absolute;
		right: 10px;
		bottom: 10px;
		padding: 3px 6px;
		background: rgb(255 255 255 / 90%);
		color: #111111;
		font-size: 7px;
		letter-spacing: 0.025em;
	}

	.artwork-series {
		margin: 0 0 4px;
		color: #6e6e6e	;
		font-family: "Inter", Arial, sans-serif;
		font-size: 10px;
		text-transform: uppercase;
		letter-spacing: 0.16em;
	}

	.artwork-card h2 {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 8px;
		margin: 0;
		font-family: "Lora", Georgia, serif;
		font-size: 17px;
		font-weight: 400;
		line-height: 1.3;
	}

	.artwork-card h2 > span:first-child {
		min-width: 0;
	}

	.artwork-title-arrow {
		flex: none;
		visibility: hidden;
		color: #111111;
		opacity: 0;
		transform: translateX(-4px);
		transition: opacity 180ms ease, transform 180ms ease, visibility 0s linear 180ms;
	}

	@media (hover: hover) {
		.artwork-card:hover .artwork-title-arrow {
			visibility: visible;
			opacity: 1;
			transform: translateX(0);
			transition-delay: 0s;
		}
	}

	.artwork-description {
		margin: 3px 0 0;
		color: #6e6e6e;
		font-family: "Lora", Georgia, serif;
		font-size: 8px;
		line-height: 1.5;
	}

	@media (prefers-reduced-motion: reduce) {
		.artwork-title-arrow {
			transition: none;
		}
	}
</style>
