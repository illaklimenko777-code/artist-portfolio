---
import artworkOne from "../../assets/img/works-img-1.png";
import artworkTwo from "../../assets/img/works-img-2.png";
import artworkThree from "../../assets/img/works-img-3.png";
import artworkFour from "../../assets/img/works-img-4.png";
import artworkFive from "../../assets/img/works-img-5.png";
import artworkSix from "../../assets/img/works-img-6.png";

const artworks = [
	{
		image: artworkOne,
		titleUk: "«Екзувій: Страх, що нічого не вийде»",
		titleEn: "“Exuvia: The fear that nothing will work out”",
		descriptionUk: "2026 · 30 × 20 cm\nЕпоксидна смола, поталь, пігменти, текстурні пасти, емаль",
		descriptionEn: "2026 · 30 × 20 cm\nEpoxy resin, metal leaf, pigments, texture paste, enamel",
	},
	{
		image: artworkTwo,
		titleUk: "«Екзувій II: Тінь сумнівів»",
		titleEn: "“Exuvia II: Shadow of doubt”",
		descriptionUk: "2026 · 30 × 20 cm\nМетал, авторська техніка",
		descriptionEn: "2026 · 30 × 20 cm\nMetal, original technique",
	},
	{
		image: artworkThree,
		titleUk: "«Екзувій III: Золота пастка»",
		titleEn: "“Exuvia III: Golden trap”",
		descriptionUk: "2026 · 30 × 20 cm\nЕпоксидна смола, поталь, пігменти",
		descriptionEn: "2026 · 30 × 20 cm\nEpoxy resin, metal leaf, pigments",
	},
	{
		image: artworkFour,
		titleUk: "«Екзувій IV: Жива матерія»",
		titleEn: "“Exuvia IV: Living matter”",
		descriptionUk: "2026 · 30 × 20 cm\nЕпоксидна смола, пігменти, текстурна паста",
		descriptionEn: "2026 · 30 × 20 cm\nEpoxy resin, pigments, texture paste",
	},
	{
		image: artworkFive,
		titleUk: "«Екзувій V: Прозора межа»",
		titleEn: "“Exuvia V: Transparent boundary”",
		descriptionUk: "2026 · 30 × 20 cm\nЕпоксидна смола, пігменти",
		descriptionEn: "2026 · 30 × 20 cm\nEpoxy resin, pigments",
	},
	{
		image: artworkSix,
		titleUk: "«Екзувій VI: Відбиток тіні»",
		titleEn: "“Exuvia VI: Imprint of a shadow”",
		descriptionUk: "2026 · 30 × 20 cm\nЕпоксидна смола, авторська техніка",
		descriptionEn: "2026 · 30 × 20 cm\nEpoxy resin, original technique",
	},
];
---

<dialog
	class="home-artwork-dialog"
	aria-label="Огляд роботи"
	data-artworks={JSON.stringify(artworks.map(({ image, titleUk, titleEn, descriptionUk, descriptionEn }) => ({
		imageSrc: image.src,
		titleUk,
		titleEn,
		descriptionUk,
		descriptionEn,
	})))}
>
	<div class="home-artwork-modal">
		<header class="home-artwork-header">
			<p data-uk="ОЛЕКСАНДРА ГЛУЩЕНКО · EXUVIAE" data-en="ALEXANDRA HLUSHCHENKO · EXUVIAE">
				ОЛЕКСАНДРА ГЛУЩЕНКО · EXUVIAE
			</p>
			<button class="home-artwork-close" type="button" aria-label="Закрити">
				<span aria-hidden="true">&times;</span>
				<span data-uk="ЗАКРИТИ" data-en="CLOSE">ЗАКРИТИ</span>
			</button>
		</header>

		<div class="home-artwork-content">
			<div class="home-artwork-media">
				<img class="home-artwork-main-image" src={artworks[0].image.src} alt={artworks[0].titleUk} />
				<video class="home-artwork-video" controls preload="metadata" playsinline hidden>
					<source src="/work-video-browser.mp4" type="video/mp4" />
				</video>
			</div>

			<div class="home-artwork-details">
				<p class="home-artwork-kicker" data-uk="СЕРІЯ «EXUVIAE»" data-en="“EXUVIAE” SERIES">СЕРІЯ «EXUVIAE»</p>
				<h2 class="home-artwork-title">{artworks[0].titleUk}</h2>
				<p class="home-artwork-description">{artworks[0].descriptionUk}</p>
				<div class="home-artwork-copy">
					<p data-uk="Базовий шар паралельного сузір’я." data-en="The base layer of a parallel constellation.">
						Базовий шар паралельного сузір’я.
					</p>
					<p data-uk="Маска сприймає відносність кожного елемента." data-en="The mask reveals the relativity of every element.">
						Маска сприймає відносність кожного елемента.
					</p>
					<p data-uk="Робота входить до проєкту «EXUVIAE»." data-en="The work belongs to the “EXUVIAE” project.">
						Робота входить до проєкту «EXUVIAE».
					</p>
				</div>
			</div>
		</div>

		<footer class="home-artwork-footer">
			<div class="home-artwork-thumbnails">
				{artworks.map((artwork, index) => (
					<button
						class="home-artwork-thumbnail"
						type="button"
						data-index={String(index)}
						aria-label={`${index + 1}`}
						aria-current={index === 0 ? "true" : undefined}
					>
						<img src={artwork.image.src} alt="" />
					</button>
				))}
				<button class="home-artwork-thumbnail home-artwork-video-thumbnail" type="button" data-video="true" aria-label="Відео">
					<span data-uk="ВІДЕО" data-en="VIDEO">ВІДЕО</span>
				</button>
			</div>
			<div class="home-artwork-instagram">
				<p data-uk="ВІДЕО ТА ПУБЛІКАЦІЇ В INSTAGRAM" data-en="VIDEO AND PUBLICATIONS ON INSTAGRAM">
					ВІДЕО ТА ПУБЛІКАЦІЇ В INSTAGRAM
				</p>
				<a
					href="https://www.instagram.com/a.h.mystery.art?stkn=cTEzYWI0YzFvZGtl"
					target="_blank"
					rel="noopener noreferrer"
				>
					<span data-uk="ПЕРЕГЛЯНУТИ В INSTAGRAM (@A.H.MYSTERY.ART)" data-en="VIEW ON INSTAGRAM (@A.H.MYSTERY.ART)">
						ПЕРЕГЛЯНУТИ В INSTAGRAM (@A.H.MYSTERY.ART)
					</span>
					<span aria-hidden="true">&nearr;</span>
				</a>
			</div>
		</footer>
	</div>
</dialog>

<script is:inline>
	const dialog = document.querySelector(".home-artwork-dialog");
	if (dialog) {
		const artworks = JSON.parse(dialog.dataset.artworks || "[]");
		const mainImage = dialog.querySelector(".home-artwork-main-image");
		const video = dialog.querySelector(".home-artwork-video");
		const title = dialog.querySelector(".home-artwork-title");
		const description = dialog.querySelector(".home-artwork-description");
		const thumbnails = Array.from(dialog.querySelectorAll(".home-artwork-thumbnail"));
		let activeIndex = 0;
		let showingVideo = false;
		let savedScrollY = 0;

		function renderDescription(value) {
			if (!description) return;
			const [dimensions, materials] = value.split("\n", 2);
			description.replaceChildren(
				document.createTextNode(dimensions ?? ""),
				document.createElement("br"),
				document.createTextNode(materials ?? ""),
			);
		}

		function renderArtwork(index, text) {
			activeIndex = (index + artworks.length) % artworks.length;
			const artwork = artworks[activeIndex];
			if (!artwork || !mainImage || !video || !title || !description) return;

			showingVideo = false;
			video.pause();
			video.hidden = true;
			mainImage.hidden = false;
			mainImage.src = artwork.imageSrc;
			mainImage.alt = text?.altUk || artwork.titleUk;
			const language = document.documentElement.lang === "en" ? "en" : "uk";
			title.textContent = language === "en"
				? text?.titleEn || artwork.titleEn
				: text?.titleUk || artwork.titleUk;
			renderDescription(language === "en"
				? text?.descriptionEn || artwork.descriptionEn
				: text?.descriptionUk || artwork.descriptionUk);
			thumbnails.forEach((thumbnail) => {
				if (thumbnail.dataset.video !== "true" && Number(thumbnail.dataset.index) === activeIndex) {
					thumbnail.setAttribute("aria-current", "true");
				} else {
					thumbnail.removeAttribute("aria-current");
				}
			});
		}

		function showVideo() {
			if (!mainImage || !video) return;
			showingVideo = true;
			video.hidden = false;
			mainImage.hidden = true;
			video.play().catch(() => {});
			thumbnails.forEach((thumbnail) => {
				if (thumbnail.dataset.video === "true") thumbnail.setAttribute("aria-current", "true");
				else thumbnail.removeAttribute("aria-current");
			});
		}

		function lockPage() {
			savedScrollY = window.scrollY;
			document.body.style.position = "fixed";
			document.body.style.top = `-${savedScrollY}px`;
			document.body.style.left = "0";
			document.body.style.right = "0";
			document.body.style.overflow = "hidden";
			document.documentElement.style.overflow = "hidden";
			document.body.classList.add("home-artwork-open");
		}

		function unlockPage() {
			document.body.classList.remove("home-artwork-open");
			document.body.style.position = "";
			document.body.style.top = "";
			document.body.style.left = "";
			document.body.style.right = "";
			document.body.style.overflow = "";
			document.documentElement.style.overflow = "";
			window.scrollTo(0, savedScrollY);
		}

		dialog.querySelector(".home-artwork-close")?.addEventListener("click", () => dialog.close());
		dialog.addEventListener("click", (event) => {
			if (event.target === dialog) dialog.close();
		});
		dialog.addEventListener("wheel", (event) => {
			const modal = dialog.querySelector(".home-artwork-modal");
			if (modal && !modal.contains(event.target)) {
				event.preventDefault();
			}
		}, { passive: false });
		thumbnails.forEach((thumbnail) => {
			thumbnail.addEventListener("click", () => {
				if (thumbnail.dataset.video === "true") showVideo();
				else renderArtwork(Number(thumbnail.dataset.index));
			});
		});

		window.addEventListener("home-artwork-open", (event) => {
			const index = Number(event.detail?.index);
			renderArtwork(Number.isInteger(index) && index >= 0 ? index : 0, event.detail);

			if (typeof dialog.showModal === "function") {
				if (!dialog.open) dialog.showModal();
			} else {
				dialog.setAttribute("open", "");
			}

			lockPage();
		});

		dialog.addEventListener("close", () => {
			video?.pause();
			unlockPage();
		});
	}
</script>

<style>
	:global(body.home-artwork-open) {
		overflow: hidden;
	}

	:global(html:has(body.home-artwork-open)) {
		overflow: hidden;
	}

	.home-artwork-dialog {
		position: fixed;
		inset: 0;
		width: 100vw;
		max-width: none;
		height: 100vh;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		overflow: hidden;
		overscroll-behavior: contain;
		background: transparent;
	}

	.home-artwork-dialog::backdrop {
		background: rgba(17, 17, 17, 0.84);
	}

	.home-artwork-modal {
		position: absolute;
		top: 50%;
		left: 50%;
		width: min(760px, calc(100vw - 40px));
		max-height: calc(100vh - 40px);
		overflow: auto;
		overscroll-behavior: contain;
		transform: translate(-50%, -50%);
		background: #fff;
		color: #111111;
	}

	.home-artwork-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 42px;
		padding: 0 18px;
		border-bottom: 1px solid #e6e6e6;
		font-size: 8px;
	}

	.home-artwork-header p {
		margin: 0;
	}

	.home-artwork-close {
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 7px 10px;
		border: 1px solid #e6e6e6;
		background: transparent;
		color: #111111;
		font: inherit;
		cursor: pointer;
		transition: color 160ms ease, background-color 160ms ease, border-color 160ms ease;
	}

	.home-artwork-close:hover,
	.home-artwork-close:focus-visible {
		border-color: #111111;
		background-color: #111111 !important;
		color: #fff !important;
	}

	.home-artwork-close:hover span,
	.home-artwork-close:focus-visible span {
		color: #fff !important;
	}

	.home-artwork-close:focus-visible {
		outline: 2px solid #111111;
		outline-offset: 2px;
	}

	.home-artwork-content {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
		gap: 24px;
		min-height: 390px;
		padding: 24px 18px 0;
	}

	.home-artwork-media {
		padding: 12px clamp(20px, 3.2vw, 44px);
		background: #f7f7f7;
	}

	.home-artwork-main-image,
	.home-artwork-video {
		width: 100%;
		height: 340px;
		object-fit: contain;
		background: #f1f1f1;
	}

	.home-artwork-details {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.home-artwork-kicker {
		margin: 0 0 10px;
		font-size: 8px;
		letter-spacing: 0.06em;
	}

	.home-artwork-title {
		margin: 0 0 8px;
		font-family: "Lora", Georgia, serif;
		font-size: 17px;
		font-weight: 400;
		line-height: 1.3;
	}

	.home-artwork-description {
		margin: 0;
		padding-bottom: 14px;
		border-bottom: 1px solid #e6e6e6;
		color: #6e6e6e;
		font-family: "Inter", Arial, sans-serif;
		font-size: 11px;
		line-height: 1.6;
		letter-spacing: 0.02em;
		white-space: pre-line;
	}

	.home-artwork-copy {
		padding-top: 14px;
		font-family: "Lora", Georgia, serif;
		font-size: 10px;
		line-height: 1.55;
	}

	.home-artwork-copy p {
		margin: 0 0 8px;
	}

	.home-artwork-instagram {
		align-self: stretch;
		background: #f7f7f7;
		font-family: "Inter", Arial, sans-serif;
	}

	.home-artwork-instagram p {
		margin: 0;
		padding: 9px 10px 2px;
		color: #6e6e6e;
		font-size: 6px;
		letter-spacing: 0.12em;
	}

	.home-artwork-instagram a {
		display: flex;
		width: 100%;
		align-items: center;
		justify-content: flex-start;
		gap: 4px;
		padding: 3px 10px 9px;
		border: 0;
		background: transparent;
		color: #111111;
		font-family: inherit;
		font-size: 7px;
		letter-spacing: 0.08em;
		text-align: left;
		text-decoration: none;
		cursor: pointer;
	}

	.home-artwork-footer {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
		align-items: end;
		gap: 24px;
		padding: 10px 18px 16px;
	}

	.home-artwork-thumbnails {
		display: flex;
		gap: 6px;
	}

	.home-artwork-thumbnail {
		width: 48px;
		height: 58px;
		padding: 4px;
		border: 1px solid transparent;
		background: #fff;
		cursor: pointer;
	}

	.home-artwork-thumbnail[aria-current="true"] {
		border-color: #111111;
	}

	.home-artwork-thumbnail img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.home-artwork-video-thumbnail {
		display: grid;
		place-items: center;
		background: #6c6c6c;
		color: #fff;
		font-size: 7px;
	}

	@media (max-width: 700px) {
		.home-artwork-modal {
			display: flex;
			width: calc(100vw - 24px);
			flex-direction: column;
			max-height: calc(100dvh - 24px);
			overflow-y: auto;
		}

		.home-artwork-header {
			position: sticky;
			top: 0;
			z-index: 2;
			background: #fff;
		}

		.home-artwork-content,
		.home-artwork-footer {
			display: contents;
		}

		.home-artwork-media {
			order: 1;
			padding: 10px 10% 0;
		}

		.home-artwork-main-image,
		.home-artwork-video {
			height: min(42dvh, 280px);
		}

		.home-artwork-thumbnails {
			display: grid;
			width: calc(100% - 36px);
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 8px;
			order: 2;
			max-width: none;
			margin: 0 auto;
			padding: 12px 0 0;
		}

		.home-artwork-details {
			order: 3;
			padding: 14px 18px 0;
		}

		.home-artwork-instagram {
			order: 4;
			margin: 16px 18px;
		}

		.home-artwork-title {
			font-size: 19px;
		}

		.home-artwork-thumbnail {
			width: 100%;
			height: auto;
			aspect-ratio: 0.68;
		}
	}

	@media (max-width: 480px) {
		.home-artwork-modal {
			width: min(320px, calc(100vw - 24px));
		}
	}
</style>
