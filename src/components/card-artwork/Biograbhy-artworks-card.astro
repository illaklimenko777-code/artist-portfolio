---
import portrait from "../../assets/img/banner-bio-1.png";
import portraitDetail from "../../assets/img/woman-card.png";
import detailOne from "../../assets/img/banner-bio-2.png";
import detailTwo from "../../assets/img/banner-bio-3.png";

const portraits = [
	{ image: portrait, altUk: "Олександра Глущенко з роботою серії EXUVIAE", altEn: "Alexandra Hlushchenko with a work from the EXUVIAE series" },
	{ image: portraitDetail, altUk: "Портрет художниці", altEn: "Portrait of the artist" },
	{ image: detailOne, altUk: "Портрет художниці за скульптурою", altEn: "Portrait of the artist behind a sculpture" },
	{ image: detailTwo, altUk: "Художниця тримає скульптурну роботу", altEn: "The artist holding a sculptural work" },
];
---

<dialog
	class="biography-artwork-dialog"
	aria-label="Біографія Олександри Глущенко"
	data-portraits={JSON.stringify(portraits.map(({ image, altUk, altEn }) => ({
		imageSrc: image.src,
		altUk,
		altEn,
	})))}
>
	<div class="biography-artwork-modal">
		<header class="biography-artwork-header">
			<p data-uk="ОЛЕКСАНДРА ГЛУЩЕНКО · EXUVIAE" data-en="ALEXANDRA HLUSHCHENKO · EXUVIAE">
				ОЛЕКСАНДРА ГЛУЩЕНКО · EXUVIAE
			</p>
			<button class="biography-artwork-close" type="button" aria-label="Закрити">
				<span aria-hidden="true">&times;</span>
				<span data-uk="ЗАКРИТИ" data-en="CLOSE">ЗАКРИТИ</span>
			</button>
		</header>

		<div class="biography-artwork-content">
			<div class="biography-artwork-media">
				<img class="biography-artwork-main-image" src={portraits[0].image.src} alt={portraits[0].altUk} />
			</div>

			<div class="biography-artwork-details">
				<p class="biography-artwork-kicker"
					data-uk="БІОГРАФІЯ · ПРО МИТЦЯ"
					data-en="BIOGRAPHY · ABOUT THE ARTIST">
					BIOGRAPHY · ABOUT THE ARTIST
				</p>
				<h2 data-uk="Олександра Глущенко" data-en="Alexandra Hlushchenko">Alexandra Hlushchenko</h2>
				<p class="biography-artwork-subtitle" data-uk="Фотопортрет студії Photok" data-en="PHOTOKY Studio Portrait">
					PHOTOKY Studio Portrait
				</p>
				<p class="biography-artwork-copy"
					data-uk="«Моя мистецька практика — це простір трансгресії та ритуал трансформації, у якому матерія стає свідком і архівом мого внутрішнього становлення»."
					data-en="“My artistic practice is a space of transgression and a ritual of transformation, in which matter becomes a witness, an archive of my inner becoming.”">
					“My artistic practice is a space of transgression and a ritual of transformation, in which matter becomes a witness, an archive of my inner becoming.”
				</p>
			</div>
		</div>

		<footer class="biography-artwork-footer">
			<div class="biography-artwork-thumbnails">
				{portraits.map((item, index) => (
					<button
						class="biography-artwork-thumbnail"
						type="button"
						data-index={String(index)}
						aria-label={`${index + 1}`}
						aria-current={index === 0 ? "true" : undefined}
					>
						<img src={item.image.src} alt="" />
					</button>
				))}
			</div>
			<div class="biography-artwork-instagram">
				<p data-uk="ВІДЕО ТА ПУБЛІКАЦІЇ В INSTAGRAM" data-en="VIDEO & INSTAGRAM FEATURE">
					VIDEO & INSTAGRAM FEATURE
				</p>
				<a
					href="https://www.instagram.com/a.h.mystery.art?stkn=cTEzYWI0YzFvZGtl"
					target="_blank"
					rel="noopener noreferrer"
				>
					<span data-uk="ПЕРЕГЛЯНУТИ В INSTAGRAM (@A.H.MYSTERY.ART)" data-en="VIEW ON INSTAGRAM (@A.H.MYSTERY.ART)">
						VIEW ON INSTAGRAM (@A.H.MYSTERY.ART)
					</span>
					<span aria-hidden="true">&nearr;</span>
				</a>
			</div>
		</footer>
	</div>
</dialog>

<script is:inline>
	const biographyDialog = document.querySelector(".biography-artwork-dialog");
	if (biographyDialog) {
		const portraits = JSON.parse(biographyDialog.dataset.portraits || "[]");
		const mainImage = biographyDialog.querySelector(".biography-artwork-main-image");
		const thumbnails = Array.from(biographyDialog.querySelectorAll(".biography-artwork-thumbnail"));
		let savedScrollY = 0;

		function showBiographyPortrait(index) {
			const safeIndex = (index + portraits.length) % portraits.length;
			const portrait = portraits[safeIndex];
			if (!portrait || !mainImage) return;

			mainImage.src = portrait.imageSrc;
			const language = document.documentElement.lang === "en" ? "en" : "uk";
			mainImage.alt = language === "en" ? portrait.altEn : portrait.altUk;
			thumbnails.forEach((thumbnail) => {
				if (Number(thumbnail.dataset.index) === safeIndex) thumbnail.setAttribute("aria-current", "true");
				else thumbnail.removeAttribute("aria-current");
			});
		}

		function openBiographyPortrait(index) {
			showBiographyPortrait(index);
			if (!biographyDialog.open) biographyDialog.showModal();
			savedScrollY = window.scrollY;
			document.body.style.position = "fixed";
			document.body.style.top = `-${savedScrollY}px`;
			document.body.style.left = "0";
			document.body.style.right = "0";
			document.body.style.overflow = "hidden";
			document.documentElement.style.overflow = "hidden";
			document.body.classList.add("biography-artwork-open");
		}

		biographyDialog.querySelector(".biography-artwork-close")?.addEventListener("click", () => biographyDialog.close());
		biographyDialog.addEventListener("click", (event) => {
			if (event.target === biographyDialog) biographyDialog.close();
		});
		biographyDialog.addEventListener("wheel", (event) => {
			const modal = biographyDialog.querySelector(".biography-artwork-modal");
			if (modal && !modal.contains(event.target)) event.preventDefault();
		}, { passive: false });

		thumbnails.forEach((thumbnail) => {
			thumbnail.addEventListener("click", () => showBiographyPortrait(Number(thumbnail.dataset.index)));
		});

		document.querySelectorAll(".portrait-collage img[data-biography-index]").forEach((image) => {
			const index = Number(image.dataset.biographyIndex);
			image.setAttribute("role", "button");
			image.setAttribute("tabindex", "0");
			image.addEventListener("click", () => openBiographyPortrait(index));
			image.addEventListener("keydown", (event) => {
				if (event.key === "Enter" || event.key === " ") {
					event.preventDefault();
					openBiographyPortrait(index);
				}
			});
		});

		biographyDialog.addEventListener("close", () => {
			document.body.style.position = "";
			document.body.style.top = "";
			document.body.style.left = "";
			document.body.style.right = "";
			document.body.style.overflow = "";
			document.documentElement.style.overflow = "";
			document.body.classList.remove("biography-artwork-open");
			window.scrollTo(0, savedScrollY);
		});
	}
</script>

<style>
	:global(body.biography-artwork-open) {
		overflow: hidden;
	}

	.biography-artwork-dialog {
		position: fixed;
		inset: 0;
		width: 100vw;
		max-width: none;
		height: 100vh;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		overflow: hidden;
		overscroll-behavior: contain;
		background: transparent;
	}

	.biography-artwork-dialog::backdrop {
		background: rgba(17, 17, 17, 0.84);
	}

	.biography-artwork-modal {
		position: absolute;
		top: 50%;
		left: 50%;
		display: flex;
		width: min(760px, calc(100vw - 40px));
		max-height: min(500px, calc(100vh - 40px));
		flex-direction: column;
		overflow: auto;
		overscroll-behavior: contain;
		transform: translate(-50%, -50%);
		background: #fff;
		color: #111111;
	}

	.biography-artwork-header {
		display: flex;
		min-height: 48px;
		align-items: center;
		justify-content: space-between;
		padding: 0 22px;
		border-bottom: 1px solid #e6e6e6;
		font-size: 8px;
		letter-spacing: 0.08em;
	}

	.biography-artwork-header p {
		margin: 0;
	}

	.biography-artwork-close {
		display: flex;
		align-items: center;
		gap: 5px;
		padding: 7px 10px;
		border: 1px solid #e6e6e6;
		background: transparent;
		color: #111111;
		font: inherit;
		cursor: pointer;
	}

	.biography-artwork-close:hover,
	.biography-artwork-close:focus-visible {
		border-color: #111111;
		background-color: #111111 !important;
		color: #fff !important;
	}

	.biography-artwork-close:hover span,
	.biography-artwork-close:focus-visible span {
		color: #fff !important;
	}

	.biography-artwork-content {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
		gap: 24px;
		padding: 24px 22px 0;
	}

	.biography-artwork-media {
		padding: 12px clamp(20px, 3.2vw, 44px);
		background: #f7f7f7;
	}

	.biography-artwork-main-image {
		display: block;
		width: 100%;
		height: 300px;
		object-fit: contain;
		background: #f1f1f1;
	}

	.biography-artwork-details {
		min-width: 0;
	}

	.biography-artwork-kicker {
		margin: 0 0 8px;
		color: #6e6e6e;
		font-size: 7px;
		letter-spacing: 0.11em;
	}

	.biography-artwork-details h2 {
		margin: 0 0 7px;
		font-family: "Lora", Georgia, serif;
		font-size: 17px;
		font-weight: 400;
		line-height: 1.3;
	}

	.biography-artwork-subtitle {
		margin: 0;
		padding-bottom: 12px;
		border-bottom: 1px solid #e6e6e6;
		color: #6e6e6e;
		font-family: "Inter", Arial, sans-serif;
		font-size: 11px;
		line-height: 1.6;
		letter-spacing: 0.02em;
	}

	.biography-artwork-copy {
		margin: 14px 0 0;
		font-family: "Lora", Georgia, serif;
		font-size: 10px;
		line-height: 1.6;
	}

	.biography-artwork-footer {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
		align-items: end;
		gap: 24px;
		padding: 10px 22px 22px;
	}

	.biography-artwork-thumbnails {
		display: flex;
		gap: 6px;
	}

	.biography-artwork-thumbnail {
		width: 42px;
		height: 58px;
		padding: 3px;
		border: 1px solid transparent;
		background: #fff;
		cursor: pointer;
	}

	.biography-artwork-thumbnail[aria-current="true"] {
		border-color: #111111;
	}

	.biography-artwork-thumbnail img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.biography-artwork-instagram {
		background: #f7f7f7;
		font-family: "Inter", Arial, sans-serif;
	}

	.biography-artwork-instagram p {
		margin: 0;
		padding: 9px 10px 2px;
		color: #6e6e6e;
		font-size: 6px;
		letter-spacing: 0.12em;
	}

	.biography-artwork-instagram a {
		display: flex;
		width: 100%;
		align-items: center;
		gap: 4px;
		padding: 3px 10px 9px;
		border: 0;
		background: transparent;
		color: #111111;
		font-family: inherit;
		font-size: 7px;
		letter-spacing: 0.08em;
		text-align: left;
		text-decoration: none;
		cursor: pointer;
	}

	@media (max-width: 700px) {
		.biography-artwork-modal {
			width: calc(100vw - 24px);
			max-height: calc(100dvh - 24px);
			overflow-y: auto;
		}

		.biography-artwork-header {
			position: sticky;
			top: 0;
			z-index: 2;
			background: #fff;
		}

		.biography-artwork-content,
		.biography-artwork-footer {
			display: contents;
		}

		.biography-artwork-media {
			order: 1;
			padding: 10px 10% 0;
		}

		.biography-artwork-main-image {
			height: min(42dvh, 280px);
		}

		.biography-artwork-thumbnails {
			display: grid;
			width: calc(100% - 36px);
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 8px;
			order: 2;
			max-width: none;
			margin: 0 auto;
			padding: 12px 0 0;
		}

		.biography-artwork-details {
			order: 3;
			padding: 14px 18px 0;
		}

		.biography-artwork-instagram {
			order: 4;
			margin: 16px 18px;
		}

		.biography-artwork-thumbnail {
			width: 100%;
			height: auto;
			aspect-ratio: 0.68;
		}
	}

	@media (max-width: 480px) {
		.biography-artwork-modal {
			width: min(320px, calc(100vw - 24px));
		}
	}
</style>
