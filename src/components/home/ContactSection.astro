					<dt data-uk="INSTAGRAM" data-en="INSTAGRAM">INSTAGRAM</dt>
					<dd>
						<a href="https://www.instagram.com/a.h.mystery.art?stkn=cTEzYWI0YzFvZGtl" target="_blank" rel="noopener noreferrer">
							@a.m.mystery.art
						</a>
					</dd>
				</div>
				<div>
					<dt data-uk="ТЕЛЕФОН" data-en="PHONE">ТЕЛЕФОН</dt>
					<dd><a href="#" data-placeholder-link>+38 050 062 32 25</a></dd>
