	</div>

	<div class="contacts-grid">
		<div class="artist-contact">
			<h3 data-uk="Олександра Глущенко" data-en="Alexandra Hlushchenko">Олександра Глущенко</h3>
			<p
				class="artist-description"
				data-uk="Художниця та скульпторка. Відкрита до співпраці й мистецьких проєктів."
