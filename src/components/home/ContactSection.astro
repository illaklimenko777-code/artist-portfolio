		<form
			class="contact-form"
			id="contact-form"
		>
			<div class="form-fields">
				<label>
					<span class="visually-hidden" data-uk="Ваше ім’я" data-en="Your name">Ваше ім’я</span>
					<input
						type="text"
						name="name"
						autocomplete="name"
						required
						placeholder="Ваше ім’я"
						data-placeholder-uk="Ваше ім’я"
						data-placeholder-en="Your name"
					/>
				</label>
				<label>
					<span class="visually-hidden" data-uk="E-mail або телефон" data-en="Email or phone">
						E-mail або телефон
					</span>
					<input
						type="text"
						name="replyTo"
						autocomplete="email"
						required
						placeholder="E-mail або телефон"
						data-placeholder-uk="E-mail або телефон"
						data-placeholder-en="Email or phone"
					/>
				</label>
				<label class="message-field">
					<span class="visually-hidden" data-uk="Повідомлення" data-en="Message">Повідомлення</span>
					<textarea
						name="message"
						required
						rows="2"
						placeholder="Ваше повідомлення..."
						data-placeholder-uk="Ваше повідомлення..."
						data-placeholder-en="Your message..."
					></textarea>
				</label>
