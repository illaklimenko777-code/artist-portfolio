		<span data-uk="Instagram:" data-en="Instagram:">Instagram:</span> @a.m.mystery.art
	</a>
</footer>

<script>
	const contactForm = document.querySelector<HTMLFormElement>("#contact-form");

	if (contactForm) {
		const nameInput = contactForm.querySelector<HTMLInputElement>('input[name="name"]');
		const replyToInput = contactForm.querySelector<HTMLInputElement>('input[name="replyTo"]');
		const messageInput = contactForm.querySelector<HTMLTextAreaElement>('textarea[name="message"]');

		if (!nameInput || !replyToInput || !messageInput) {
			throw new Error("Contact form fields are missing.");
		}

		const nameField = nameInput;
		const replyToField = replyToInput;
		const messageField = messageInput;
		const storageKey = "artist-portfolio-contact-draft";
		let storageAvailable = true;

		function persistContactValues() {
			if (!storageAvailable) return false;

			try {
				const contactValues: Record<string, string> = {};
				contactValues["name"] = nameField.value;
				contactValues["replyTo"] = replyToField.value;
				contactValues["message"] = messageField.value;
				localStorage.setItem(storageKey, JSON.stringify(contactValues));
				return true;
			} catch (error) {
				storageAvailable = false;
				console.error("Unable to save contact form values in this browser.", error);
				return false;
			}
		}

		try {
			const savedValues = localStorage.getItem(storageKey);
			if (savedValues) {
				const parsed: unknown = JSON.parse(savedValues);
				if (
					typeof parsed === "object"
					&& parsed !== null
					&& "name" in parsed
					&& "replyTo" in parsed
					&& "message" in parsed
					&& typeof parsed.name === "string"
					&& typeof parsed.replyTo === "string"
					&& typeof parsed.message === "string"
				) {
					nameField.value = parsed.name;
					replyToField.value = parsed.replyTo;
					messageField.value = parsed.message;
				} else {
					throw new Error("Saved contact form values have an invalid format.");
				}
			}
		} catch (error) {
			console.error("Unable to restore saved contact form values.", error);
		}

		contactForm.addEventListener("input", persistContactValues);
		contactForm.addEventListener("submit", (event) => {
			event.preventDefault();
			const saved = persistContactValues();
			const isEnglish = document.documentElement.lang === "en";
			window.alert(saved
				? isEnglish
					? "Thank you! Your message has been saved in this browser."
					: "Дякуємо! Ваше повідомлення збережено в цьому браузері."
				: isEnglish
					? "Your message could not be saved in this browser. Please try again."
					: "Не вдалося зберегти повідомлення в цьому браузері. Спробуйте ще раз.");
		});
	}
</script>

